FROM ubuntu:22.04 AS builder

# 设置工作目录
WORKDIR /build

# 安装依赖
RUN set -eux; \
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        curl \
        ca-certificates \
        git \
        unzip \
        jq \
    && rm -rf /var/lib/apt/lists/*

# 下载并解压 wrapper (multi-arch)
ARG TARGETARCH
ARG GITHUB_TOKEN
RUN set -eux; \
    mkdir -p /build/wrapper; \
    latest_tag=$(curl -s https://api.github.com/repos/WorldObservationLog/wrapper/releases/latest | jq -r .tag_name); \
    if [ "$TARGETARCH" = "amd64" ]; then \
        amd64_url="https://github.com/WorldObservationLog/wrapper/releases/download/${latest_tag}/${latest_tag}.zip"; \
        curl -L "$amd64_url" -o /build/wrapper_amd64.zip; \
        unzip /build/wrapper_amd64.zip -d /build/wrapper/; \
    elif [ "$TARGETARCH" = "arm64" ]; then \
        # 1️⃣ 获取 Build for arm64 workflow ID
        workflow_id=$(curl -s -H "Authorization: Bearer $GITHUB_TOKEN" \
            https://api.github.com/repos/chas0000/wrapper/actions/workflows \
            | jq -r '.workflows[] | select(.name=="Build for arm64") | .id'); \
        echo "Workflow ID: $workflow_id"; \
        # 2️⃣ 获取最新成功 run ID
        run_id=$(curl -s -H "Authorization: Bearer $GITHUB_TOKEN" \
            "https://api.github.com/repos/chas0000/wrapper/actions/workflows/${workflow_id}/runs?status=success&per_page=1" \
            | jq -r '.workflow_runs[0].id'); \
        echo "Latest run ID: $run_id"; \
        # 3️⃣ 获取 artifact 的下载 API URL
        artifact_url=$(curl -s -H "Authorization: Bearer $GITHUB_TOKEN" \
            "https://api.github.com/repos/chas0000/wrapper/actions/runs/${run_id}/artifacts" \
            | jq -r '.artifacts[] | select(.name | contains("Wrapper.arm64")) | .archive_download_url'); \
        echo "Artifact API URL: $artifact_url"; \
        # 4️⃣ 下载 artifact zip
        curl -L -H "Authorization: Bearer $GITHUB_TOKEN" \
             -H "Accept: application/vnd.github+json" \
             "$artifact_url" -o /build/wrapper_arm64.zip; \
        unzip /build/wrapper_arm64.zip -d /build/wrapper/; \
    fi

# 最终镜像
FROM ubuntu:22.04

# 从 builder 阶段复制 wrapper 文件
COPY --from=builder /build/wrapper /app/wrapper

# 从 context 复制 wm_server 和 index.html (由 action 编译)
ARG TARGETARCH
COPY ./output/wm_server-${TARGETARCH} /app/wrapper/wm_server
COPY ./output/index.html /app/wrapper/index.html

# 复制配置文件备份
COPY ./backup/wm_config.yaml /app/backup/wm_config.yaml

# 复制启动脚本
COPY ./wrapper_start.sh /app/wrapper_start.sh
RUN chmod +x /app/wrapper_start.sh

# 设置工作目录
WORKDIR /app/wrapper

# 设置权限
RUN chmod +x /app/wrapper/wm_server


# 暴露端口
EXPOSE 8080

# 默认启动脚本（处理配置备份并启动 wm_server）
CMD ["/app/wrapper_start.sh"]
